# ─── Frontend (exposed to the browser — only PUBLIC values here!) ───
# Supabase Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...). A legacy "anon" JWT also works.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── NEVER put these in a VITE_ variable ───
# TMDB credentials live ONLY in Edge Function secrets:
#   supabase secrets set TMDB_READ_ACCESS_TOKEN=eyJhbGciOi...
# (see supabase/functions/.env.example for local function development)
