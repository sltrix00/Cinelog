# Local Supabase Edge Function secrets
# Copy to `supabase/functions/.env` for `supabase functions serve`
# For production deploy: `supabase secrets set TMDB_READ_ACCESS_TOKEN=...`

TMDB_READ_ACCESS_TOKEN=eyJhbGciOi...
# Optional fallback if you prefer TMDB v3 API key instead of v4 Read Access Token
# TMDB_API_KEY=your_tmdb_v3_api_key

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_local_or_project_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_local_or_project_service_role_key
